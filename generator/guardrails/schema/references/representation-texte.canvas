{
	"nodes":[
		{"id":"note:lecture","type":"text","x":0,"y":-300,"width":760,"height":180,"text":"# Représenter un texte\n\n**Type** · carte de concepts\n\nChaque arête nomme une relation. La position et la couleur ne créent aucun ordre de traitement."},
		{"id":"caractere-abstrait","type":"text","x":0,"y":0,"width":280,"height":130,"text":"**Caractère abstrait**\n\nUnité sémantique encodée par Unicode"},
