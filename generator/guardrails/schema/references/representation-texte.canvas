		{"id":"grapheme","type":"text","x":200,"y":320,"width":300,"height":150,"text":"**Grapheme cluster**\n\nUnité que l'utilisateur peut percevoir comme un caractère"},
		{"id":"normalisation","type":"text","x":700,"y":320,"width":300,"height":150,"text":"**Normalisation Unicode**\n\nChoisir une forme canonique ou de compatibilité"},
		{"id":"chaine-python","type":"text","x":1200,"y":320,"width":300,"height":150,"text":"**str Python**\n\nSéquence de points de code manipulée par le programme"}
